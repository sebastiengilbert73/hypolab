# LLM Provider Configuration (LiteLLM format)
# Examples:
#   gemini/gemini-2.5-flash
#   openai/gpt-4o-mini
#   anthropic/claude-3-5-sonnet-20241022
#   ollama/llama3.1
HYPOLAB_MODEL=gemini/gemini-2.5-flash

# API Keys (set the one matching your chosen provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Ollama base URL if using local models
OLLAMA_API_BASE=http://localhost:11434

# Statistical settings
HYPOLAB_ALPHA=0.05
HYPOLAB_MAX_HYPOTHESES=6
HYPOLAB_SANDBOX_TIMEOUT=15
